# Dependencies
node_modules/
package-lock.json
.pnp
.pnp.js

# Testing
coverage/

# Specs and docs: markdown is tracked inside openspec/ and docs/ only.
# A bare *.md rule would also hide openspec/, which is the point of this change.
*.xml
*.md
!README.md
!AGENTS.md
!openspec/**
!docs/**
# Production
build/
dist/
out/

# Misc
.DS_Store
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Editor directories and files
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
*.swp
*.swo

# OS generated files
Thumbs.db

# Application specific
.jamcli/
.commandcode/
agents.config.json
scripts/test-history.ts
