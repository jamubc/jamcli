{
  "name": "jamcli",
  "version": "1.0.0",
  "description": "Enterprise-Grade AI CLI for Local Development",
  "type": "module",
  "bin": {
    "jamcli": "./dist/index.js"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "start": "dist/index.js",
    "dev": "bun --watch src/index.tsx",
    "test": "bun test",
    "test:history": "node --import tsx scripts/test-history.ts",
    "config-schema": "bun src/core/config/writeSchema.ts",
    "bench": "bun scripts/bench/run.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.22.0",
    "@opentui/core": "0.5.12",
    "@opentui/react": "0.5.12",
    "clipboardy": "^5.0.1",
    "diff": "^5.2.0",
    "dotenv": "^16.4.5",
    "env-paths": "^3.0.0",
    "ignore": "7.0.10",
    "react": "^19.2.0",
    "string-width": "^8.1.0",
    "uuid": "^13.0.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/diff": "^5.0.9",
    "@types/node": "^20.11.24",
    "@types/react": "^19.2.0",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.16.5",
    "typescript": "^7.0.2"
  },
  "module": "src/index.tsx",
  "private": true
}
