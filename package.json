{
  "name": "jamcli",
  "version": "1.0.0",
  "description": "Enterprise-Grade AI CLI for Local Development",
  "type": "module",
  "bin": {
    "jamcli": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "postbuild": "chmod +x dist/index.js",
    "start": "node dist/index.js",
    "dev": "tsup --watch --onSuccess \"node dist/index.js\"",
    "test": "bun test",
    "test:history": "node --import tsx scripts/test-history.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.22.0",
    "clipboardy": "^5.0.1",
    "diff": "^5.2.0",
    "dotenv": "^16.4.5",
    "env-paths": "^3.0.0",
    "fast-glob": "^3.3.3",
    "fs-extra": "^11.2.0",
    "ink": "^7.1.1",
    "ink-text-input": "^6.0.0",
    "react": "^19.0.0",
    "string-width": "^8.1.0",
    "uuid": "^13.0.0",
    "zod": "^3.22.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/diff": "^5.0.9",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.11.24",
    "@types/react": "^19.0.0",
    "@types/uuid": "^10.0.0",
    "tsup": "^8.0.2",
    "tsx": "^4.16.5",
    "typescript": "^7.0.2"
  },
  "module": "src/index.tsx",
  "private": true
}
