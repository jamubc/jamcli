exports[`an overlay: the list, the one chosen, and how to move 1`] = `
"jamcli · project · session <session>

> /theme




┌──────────────────────────────────────────────────────────────────────────────┐
│ Themes                                                                 [Esc] │
│ Filter: type to narrow the list                                              │
│                                                                              │
│ > dark (in use)  light text on a dark background                             │
│   light          dark text on a light background                             │
│   high-contrast  the brightest colors, for low vision or bright rooms        │
│   monochrome     no color at all; every state is still a word                │
│                                                                              │
