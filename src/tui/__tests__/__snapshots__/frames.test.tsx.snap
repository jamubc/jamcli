exports[`the permission prompt for a command 1`] = `
"jamcli · project · session <session>

> run the tests
? asking: run_command npm test







┌──────────────────────────────────────────────────────────────────────────────┐
│ Allow run_command npm test?                                            [Esc] │
│   npm test                                                                   │
│ Default mode asks before tools that run commands.                            │
│                                                                              │
│  1  Allow once                                                               │
│  2  Allow this session   run_command(npm test)                               │
│  3  Allow this project   run_command(npm test) · .jamcli/config.local.json   │
│  4  Deny, continue                                                           │
│  5  Deny with feedback                                                       │
│ Up/Down pattern 1/3                                                          │
└──────────────────────────────────────────────────────────────────────────────┘
default mode · ollama:fake-model · context N% · no sandbox · waiting for you
"
`;

