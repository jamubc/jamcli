exports[`the permission prompt for a command 1`] = `
"jamcli · project · session <session>

> run the tests
? run_command npm test









┌──────────────────────────────────────────────────────────────────────────────┐
│ Allow run_command npm test?                                            [Esc] │
│ Default mode asks before tools that run commands.                            │
│                                                                              │
│  1  Allow once                                                               │
│  2  Allow this session   run_command(npm test)   ▲▼ 1/3                      │
│  3  Allow this project   the same rule · .jamcli/config.local.json           │
│  4  Deny, continue                                                           │
│  5  Deny with feedback                                                       │
└──────────────────────────────────────────────────────────────────────────────┘
default mode · ollama:fake-model · context N% · no sandbox · waiting
"
`;

